<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.juegoescritura.GameController">
   <children>
      <VBox alignment="CENTER" prefHeight="207.0" prefWidth="382.0" spacing="10">
         <HBox prefHeight="11.0" prefWidth="311.0" spacing="10" />
         <Label fx:id="levelLabel" alignment="TOP_LEFT" prefHeight="17.0" prefWidth="482.0" style="-fx-font-weight: bold;" text="Nivel: 1" textAlignment="CENTER" />
         <Label fx:id="timeLabel" alignment="TOP_LEFT" prefHeight="0.0" prefWidth="446.0" style="-fx-text-fill: #ff0000; -fx-font-weight: bold;" text="Tiempo: 20s" />
         <Label fx:id="scoreLabel" nodeOrientation="LEFT_TO_RIGHT" prefHeight="17.0" prefWidth="386.0" text="Puntos: 0" />
         <Label fx:id="wordLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: blue;" text="Palabra" />
         <TextField fx:id="inputField" prefHeight="33.0" prefWidth="395.0" promptText="Escribe aquí..." />
         <Label fx:id="messageLabel" style="-fx-font-size: 14px;" text="" />
         <Button mnemonicParsing="false" onAction="#restartGame" prefHeight="29.0" prefWidth="73.0" text="REINICIAR" />
         <ImageView fx:id="sunImageView" fitHeight="105.0" fitWidth="125.0" />
      </VBox>
   </children>
</AnchorPane>
